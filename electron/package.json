{
  "name": "vektorium",
  "version": "2.0.8",
  "description": "Vektorium — Sistema de Cálculos Térmicos",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "powershell -Command \"$b=Get-ChildItem 'C:\\Program Files\\Vektorium\\resources\\A - Backup Banco de Dados\\Banco de dados\\carga_termica_BACKUP_*.db' | Sort-Object LastWriteTime -Descending | Select-Object -First 1; if($b){Copy-Item $b.FullName '..\\database\\carga_termica.db' -Force; Write-Host ('Banco atualizado: '+$b.Name)}else{Write-Error 'NENHUM BACKUP ENCONTRADO'; exit 1}\"",
    "build": "npm run prebuild && ..\\venv\\Scripts\\python.exe -c \"import sqlite3;c=sqlite3.connect('../database/carga_termica.db');v=c.execute('PRAGMA user_version').fetchone()[0];c.execute('PRAGMA user_version='+str(v+1));c.commit();print('user_version:',v,'->',v+1);c.close()\" && electron-builder --win"
  },
  "author": "Vektorium",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "electron": "^36.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.0.0"
  },
  "build": {
    "appId": "com.vektorium.app",
    "productName": "Vektorium",
    "copyright": "Copyright © 2026 Vektorium",
    "directories": {
      "output": "B:\\Documentos Programas\\App Carga Térmica\\Instalação EXE"
    },
    "win": {
      "target": "nsis",
      "icon": "../frontend/img/icon.ico",
      "artifactName": "Vektorium-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "../frontend/img/icon.ico",
      "uninstallerIcon": "../frontend/img/icon.ico",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Vektorium"
    },
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "__pycache__/**",
          "calculos/__pycache__/**",
          "!scripts/**",
          "!calc_remoto_client.py",
          "!routers/calc_remoto.py"
        ]
      },
      {
        "from": "../frontend",
        "to": "frontend",
        "filter": ["**/*"]
      },
      {
        "from": "../python-embed",
        "to": "python-embed",
        "filter": ["**/*"]
      },
      {
        "from": "../database",
        "to": "database",
        "filter": [
          "carga_termica.db"
        ]
      },
      {
        "from": "../dados",
        "to": "dados",
        "filter": ["**/*"]
      },
      {
        "from": "../iniciar_app.py",
        "to": "iniciar_app.py"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "ReinaldoDietrich",
      "repo": "vektorium"
    }
  }
}
